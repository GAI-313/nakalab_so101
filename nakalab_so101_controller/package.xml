<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nakalab_so101_controller</name>
  <version>0.0.0</version>
  <description>Support ROS2 controller for SO-101</description>
  <maintainer email="nakatogawagai@gmail.com">GAI-313</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>nakalab_so101</depend>
  <depend>nakalab_so101_description</depend>

  <depend>ament_index_python</depend>
  <depend>controller_manager</depend>
  <depend>ros2_control</depend>
  <depend>hardware_interface</depend>
  <depend>joint_state_broadcaster</depend>
  <depend>joint_trajectory_controller</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>robot_state_publisher</depend>
  <depend>topic_based_ros2_control</depend>
  <depend>xacro</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
